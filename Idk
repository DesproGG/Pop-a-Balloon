    end
end)

-- ========== Wave Clicker Logic ==========
local active = false
local monitorConnection = nil
local canDetect = true

local function getWaveTextLabel()
    local hud = PlayerGui:FindFirstChild("HUD")
    if not hud then return nil end
    local top = hud:FindFirstChild("Top")
    if not top then return nil end
    local waveBar = top:FindFirstChild("WaveBar")
    if not waveBar then return nil end
    return waveBar:FindFirstChild("Text")
end

local function getWaveButtonText()
    local hud = PlayerGui:FindFirstChild("HUD")
    if not hud then return nil end
    local top = hud:FindFirstChild("Top")
    if not top then return nil end
    local buttons = top:FindFirstChild("Buttons")
    if not buttons then return nil end
    local waveButton = buttons:FindFirstChild("WaveButton")
    if waveButton then
        local textLabel = waveButton:FindFirstChild("Text")
        if textLabel then return textLabel.Text end
    end
    return nil
end

local function getTargetWaveNumber()
    local num = tonumber(WaveInput.Text)
    if num and num >= 0 then
        return num
    else
        return 221
    end
end

local function singleClick()
    if EquipLastWeapon then EquipLastWeapon:FireServer() end
    ToggleWaveState:FireServer()
end

local function doubleClick()
    if EquipLastWeapon then EquipLastWeapon:FireServer() end
    ToggleWaveState:FireServer()
    task.wait(0.1)
    if EquipLastWeapon then EquipLastWeapon:FireServer() end
    ToggleWaveState:FireServer()
end

local function startMonitoring()
    if monitorConnection then monitorConnection:Disconnect() end
    canDetect = true
    local targetNum = getTargetWaveNumber()
    StatusLabel.Text = "Status: Monitoring for 'Wave " .. targetNum .. "'"
    
    local buttonText = getWaveButtonText()
    if buttonText == "Fight" then
        StatusLabel.Text = "Status: Starting wave (Fight detected)"
        singleClick()
    end
    
    monitorConnection = RunService.Heartbeat:Connect(function()
        if not active then return end
        local waveTextLabel = getWaveTextLabel()
        if not waveTextLabel then
            StatusLabel.Text = "Status: HUD not found"
            return
        end
        local currentText = waveTextLabel.Text
        local targetNum = getTargetWaveNumber()
        local targetPattern = "Wave " .. targetNum
        if currentText == targetPattern and canDetect then
            StatusLabel.Text = "Status: Wave " .. targetNum .. " detected! Double clicking..."
            canDetect = false
            doubleClick()
            task.wait(0.1)
            canDetect = true
            StatusLabel.Text = "Status: Monitoring for 'Wave " .. targetNum .. "'"
        end
    end)
end

local function stopMonitoring()
    if monitorConnection then
        monitorConnection:Disconnect()
        monitorConnection = nil
    end
    canDetect = true
    StatusLabel.Text = "Status: Idle"
end

ToggleButton.MouseButton1Click:Connect(function()
    active = not active
    if active then
        ToggleButton.Text = "ACTIVATE: ON"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        startMonitoring()
    else
        ToggleButton.Text = "ACTIVATE: OFF"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
        stopMonitoring()
    end
end)

-- Cleanup when script stops
_G.AutoWaveClicker.Stop = function()
    stopMonitoring()
    stopCollectLoop()
    if UI and UI.Parent then UI:Destroy() end
    _G.AutoWaveClicker.UI = nil
    _G.AutoWaveClicker.Stop = nil
end

_G.AutoWaveClicker.UI = UI
