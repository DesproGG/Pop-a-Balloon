-- Dragging logic
local dragging = false
local dragStart, startPos

DragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- ========== Auto Collect Feature ==========
local autoCollectActive = false
local collectLoopConnection = nil
local collectedParts = {}

local DEBRIS_FOLDER_NAME = "Debris"
local CURRENCY_NAME = "Currency"
local COLLECT_RADIUS = 5
local COLLECT_HEIGHT_OFFSET = 2
local COLLECT_INTERVAL = 2 -- seconds
local lastCollectTime = 0

local function teleportCurrencyToPlayer(currencyPart)
    -- Check if part is still valid
    if not currencyPart or not currencyPart.Parent then return end
    if collectedParts[currencyPart] then return end
    
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    -- Mark as collected so it won't be moved again
    collectedParts[currencyPart] = true
    
    -- Clean up tracking when part is destroyed (using Destroying event)
    local function onDestroy()
        collectedParts[currencyPart] = nil
    end
    
    -- Use Destroying (fires before Destroyed) or connect to AnchestryChanged
    if currencyPart then
        currencyPart.AncestryChanged:Connect(function()
            if not currencyPart.Parent then
                collectedParts[currencyPart] = nil
            end
        end)
    end

    local angle = math.random() * 2 * math.pi
    local distance = math.random(2, COLLECT_RADIUS)
    local xOffset = math.cos(angle) * distance
    local zOffset = math.sin(angle) * distance
    local newPos = rootPart.Position + Vector3.new(xOffset, COLLECT_HEIGHT_OFFSET, zOffset)
    
    pcall(function()
        currencyPart.CFrame = CFrame.new(newPos)
    end)
end

local function collectAllCurrencyInDebris()
    local debris = workspace:FindFirstChild(DEBRIS_FOLDER_NAME)
    if not debris then return end
    
    for _, child in ipairs(debris:GetChildren()) do
        if child.Name == CURRENCY_NAME and child:IsA("BasePart") then
            teleportCurrencyToPlayer(child)
        end
    end
end

local function startCollectLoop()
    if collectLoopConnection then
        collectLoopConnection:Disconnect()
        collectLoopConnection = nil
    end
    
    -- Reset tracking when starting fresh
    collectedParts = {}
    lastCollectTime = tick()
    
    -- Collect immediately
    collectAllCurrencyInDebris()
    
    -- Set up the loop
    collectLoopConnection = RunService.Heartbeat:Connect(function()
        if not autoCollectActive then return end
        
        local currentTime = tick()
        if currentTime - lastCollectTime >= COLLECT_INTERVAL then
            lastCollectTime = currentTime
            collectAllCurrencyInDebris()
        end
    end)
end

local function stopCollectLoop()
    if collectLoopConnection then
        collectLoopConnection:Disconnect()
        collectLoopConnection = nil
    end
end

